{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--no-server-header",
        "--no-access-log"
      ],
      "port": 8000
    },
    {
      "name": "backend-live",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--no-server-header",
        "--no-access-log"
      ],
      "env": {
        "LLM_PROVIDER": "openai",
        "USER_DAILY_BUDGET_USD": "1.00",
        "APP_DAILY_BUDGET_USD": "1.00"
      },
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "frontend/node_modules/vite/bin/vite.js",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "backend-alt",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8001",
        "--no-server-header",
        "--no-access-log"
      ],
      "env": { "TRUSTED_ORIGINS": "http://127.0.0.1:5174" },
      "port": 8001
    },
    {
      "name": "backend-hybrid",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8001",
        "--no-server-header",
        "--no-access-log"
      ],
      "env": {
        "TRUSTED_ORIGINS": "http://127.0.0.1:5174",
        "RETRIEVAL_MODE": "hybrid",
        "JOB_RUNNER": "inline",
        "LLM_PROVIDER": "demo",
        "HF_HUB_OFFLINE": "1"
      },
      "port": 8001
    },
    {
      "name": "site-same-origin",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "--app-dir",
        "backend",
        "app.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8002",
        "--no-server-header",
        "--no-access-log"
      ],
      "env": {
        "FRONTEND_DIST": "frontend/dist",
        "TRUSTED_ORIGINS": "http://127.0.0.1:8002",
        "JOB_RUNNER": "inline",
        "LLM_PROVIDER": "demo"
      },
      "port": 8002
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "frontend/node_modules/vite/bin/vite.js",
        "frontend",
        "--port",
        "5174"
      ],
      "env": { "DEV_API_PORT": "8001" },
      "port": 5174
    }
  ]
}
