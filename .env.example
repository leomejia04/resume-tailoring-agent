# Copy to .env and fill in locally. Never commit real values.
# Converter backend: auto (local soffice if found, else Docker), local, or docker.
CONVERTER=auto
# Docker image for the docker backend (build: docker build -t resume-converter:dev docker/converter).
CONVERTER_IMAGE=resume-converter:dev
# Absolute path to LibreOffice's soffice executable (optional if soffice is on PATH).
SOFFICE_PATH=
# Seconds before a DOCX->PDF conversion is killed.
CONVERSION_TIMEOUT_SECONDS=60
