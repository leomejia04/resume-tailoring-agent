# Copy to .env and fill in locally. Never commit real values.
# Converter backend: auto (local soffice if found, else Docker), local, or docker.
CONVERTER=auto
# Docker image for the docker backend (build: docker build -t resume-converter:dev docker/converter).
CONVERTER_IMAGE=resume-converter:dev
# Absolute path to LibreOffice's soffice executable (optional if soffice is on PATH).
SOFFICE_PATH=
# Seconds before a DOCX->PDF conversion is killed.
CONVERSION_TIMEOUT_SECONDS=60

# development | test | production. Production disables /api/docs and enables HSTS.
APP_ENV=development
# Comma-separated exact origins allowed to call the API cross-origin. Leave empty
# when the frontend is served from the same origin (the Vite dev proxy does this).
# Example for a separately hosted frontend: https://app.example.com
CORS_ALLOWED_ORIGINS=
# Maximum request body size in bytes (default 262144 = 256 KB).
MAX_REQUEST_BYTES=262144

# --- Accounts and private storage (Supabase). For the local stack, generate a
# real .env with: npx supabase status -o env | backend/.venv/Scripts/python -m scripts.local_env
# (run from backend/). Never put the service-role key here: the backend does not use it.
SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable ("anon") key: identifies the project, grants nothing alone.
SUPABASE_ANON_KEY=replace-with-publishable-key
# Runtime connection as the least-privilege app_backend role (cannot bypass row-level security).
DATABASE_URL=postgresql+psycopg://app_backend:replace-me@127.0.0.1:54322/postgres
# Schema-owner connection used only by Alembic migrations.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace-me@127.0.0.1:54322/postgres
# Password the migration assigns to app_backend (16+ characters).
APP_DB_PASSWORD=replace-with-a-long-random-password
# Origins allowed to send state-changing requests (CSRF check). Empty = Vite dev origins.
# Required in production, e.g. https://app.example.com
TRUSTED_ORIGINS=
# Leave empty: Secure cookies in production, plain cookies on http://localhost.
COOKIE_SECURE=
# Maximum master resume upload size in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# --- Generative AI (server-side only; never exposed to the browser).
# Leave LLM_PROVIDER empty: OpenAI is used when OPENAI_API_KEY is set, otherwise AI is off.
# LLM_PROVIDER=demo uses deterministic built-in rules for local testing (refused in production).
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
# USD per 1M tokens from the model's official pricing page; verify before changing.
PRICE_INPUT_PER_MTOK=0.20
PRICE_CACHED_INPUT_PER_MTOK=0.02
PRICE_OUTPUT_PER_MTOK=1.20
PRICE_CACHE_WRITE_MULTIPLIER=1.25
# Spending limits enforced atomically before every model call.
USER_DAILY_BUDGET_USD=0.50
APP_DAILY_BUDGET_USD=5.00
